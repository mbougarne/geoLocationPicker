{
  "name": "geo-location-picker",
  "version": "1.0.4",
  "description": "A lightweight and accessible React component library for selecting geographic data: countries by continent, country names, and international phone codes. Built with flexibility and styled using Tailwind CSS.",
  "main": "dist/src/index.js",
  "module": "dist/src/index.mjs",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.mjs",
      "require": "./dist/src/index.js"
    },
    "./native": {
      "types": "./dist/native/src/index.d.ts",
      "import": "./dist/native/src/index.mjs",
      "require": "./dist/native/src/index.js"
    },
    "./dist/src/index.css": "./dist/src/index.css"
  },
  "files": [
    "dist",
    "native/package.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "check": "pnpm check:repository && pnpm lint && pnpm test && pnpm build",
    "check:repository": "node scripts/check-repository.mjs",
    "dev": "pnpm --filter dev dev",
    "lint": "eslint src native/src tests",
    "prepare": "husky install",
    "prepublishOnly": "pnpm build",
    "test": "vitest run"
  },
  "keywords": [],
  "author": "Mourad Bougarne <mouradbougarne@gmail.com>",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/mbougarn/geoLocationPicker.git"
  },
  "bugs": {
    "url": "https://github.com/mbougarn/geoLocationPicker/issues"
  },
  "homepage": "https://github.com/mbougarn/geoLocationPicker#readme",
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "react-country-flag": "^3.1.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "react-native": ">=0.75"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.15",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/eslint-plugin": "^8.27.0",
    "@typescript-eslint/parser": "^8.27.0",
    "autoprefixer": "^10.4.21",
    "esbuild-css-modules-plugin": "^3.1.4",
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^8.0.0",
    "jsdom": "^30.0.1",
    "lint-staged": "^15.5.0",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwindcss": "^4.0.15",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "{src,native/src}/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
